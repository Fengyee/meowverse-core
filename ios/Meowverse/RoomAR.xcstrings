    },
    "用相机把房间放到真实的桌面上。相机画面只在这台设备上显示，不录制，也不保存。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to put the room on a real table. The live camera view is shown only on this device and is never recorded or saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用相机把房间放到真实的桌面上。相机画面只在这台设备上显示，不录制，也不保存。"
          }
        }
      }
    },
    "相机暂时用不了，稍等一下；在 iPad 上请全屏使用" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is unavailable for now. Wait a moment; on iPad, use Meowverse full screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机暂时用不了，稍等一下；在 iPad 上请全屏使用"
          }
        }
      }
    },
