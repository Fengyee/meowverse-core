    "tour.testBuild.line" : {
      "comment" : "Test build page at the end of the opening tour, TestFlight builds only. Bella speaks. Settings › Report a Problem is the Settings row of that name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a test build. If anything feels off or breaks, please tell us in Settings › Report a Problem, or contact the developer directly. While we test, how the app works may change at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在是测试版。用着哪里别扭、哪里坏了，都请告诉我们：在“设置 › 反馈问题”里写，或者直接联系开发者。测试期间，App 的玩法和操作随时可能会变。"
          }
        }
      }
    },
    "tour.testBuild.report" : {
      "comment" : "Test build page: main button, opens Report a Problem.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report a Problem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去反馈"
          }
        }
      }
    },
    "tour.testBuild.title" : {
      "comment" : "Test build page title, above Bella's words (docs/onboarding/LINES.md beta.notice.title).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About This Test Build"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于测试版"
          }
        }
      }
    },
    "tour.topRow.1" : {
      "comment" : "Chapter 5, step 1. The window is on the whole row of buttons along the top of the room. Only the free parts are named.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up here: themes, music, your cat’s name, and a postcard of the room at top right."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一排能换主题、开音乐、给猫咪改名，右上角还能做明信片。"
          }
        }
      }
    },
    "tour.topRow.2" : {
      "comment" : "Chapter 5, step 2. The window is on the Sound button. Left out when the music is already on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music starts switched off. Turn it on here whenever you like."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐默认是关着的。想听的时候，来这儿打开。"
          }
        }
      }
    },
    "tour.topRow.3" : {
      "comment" : "Chapter 5, last step of the opening. The window is on the Settings gear. “使用导览” (Tour) is the Settings row that replays the tour.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That’s all for now. The rest comes when you get to it. Find me under Tour in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先说到这儿，别的等你用到再讲。想重听，来设置里的“使用导览”。"
          }
        }
      }
    },
    "tour.topRow.card.line" : {
      "comment" : "Chapter 5 card, one sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The room’s look, its sound and your cat are all set from this row."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "房间的样子、声音和猫咪，都从这一排改。"
          }
        }
      }
    },
    "tour.topRow.card.title" : {
      "comment" : "Chapter 5 card title; only shown when replayed from Settings. The row of buttons along the top of the room.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The row along the top"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "房间上面这一排"
          }
        }
      }
    },
    "tour.welcome.1" : {
      "comment" : "Chapter 1, step 1. The window is on the user's cat in the room.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This room belongs to your cat. This is home now."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这间房间是你家猫咪的，它就住在这儿。"
          }
        }
      }
    },
    "tour.welcome.3a" : {
      "comment" : "Chapter 1, after the user named the cat. The window is on the room's nameplate at the top, which now shows the name. Never shortened, however long the name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Lovely. The nameplate up top says so too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，好名字。上面的门牌也换好了。"
          }
        }
      }
    },
    "tour.welcome.3a.noPlate" : {
      "comment" : "Chapter 1, after the user named the cat, when the room's nameplate does not show the cat's name (the room has a name of its own). Reminder titles and the Lock Screen companion do show the cat's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Lovely. Reminders and the Lock Screen will use that name too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，好名字。以后提醒和锁屏上，都用这个名字。"
          }
        }
      }
    },
    "tour.welcome.3b" : {
      "comment" : "Chapter 1, when the user did not name the cat. The argument is the cat's current name. English says “here”: the window is on the top-bar button 猫咪, which shows no label at large text sizes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll go with %@ for now. Change it any time here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那就先叫%@。想好了，随时在“猫咪”里改。"
          }
        }
      }
    },
    "tour.welcome.3b.long" : {
      "comment" : "Chapter 1, when the user did not name the cat and its name is too long to repeat.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll keep the current name for now. Change it any time here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那就先用现在的名字。想好了，随时在“猫咪”里改。"
          }
        }
      }
    },
    "tour.welcome.4" : {
      "comment" : "Chapter 1, last step: the user's cat uses the built-in model, which was made after Bella.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right now your cat looks a lot like me. I posed for that look."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它现在的样子是照着我做的，所以我们有点像。"
          }
        }
      }
    },
    "tour.welcome.card.line" : {
      "comment" : "Chapter 1 card, one sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I’m the guide around here. Let me show you around this little room."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是这里的向导，带你认识一下这间小房间。"
          }
        }
      }
    },
    "tour.welcome.card.title" : {
      "comment" : "Chapter 1 card title. Bella is the guide's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi, I’m Bella"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好，我是 Bella"
          }
        }
      }
    }
  },
  "version" : "1.0"
