{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "tour.allDone.card.line" : {
      "comment" : "The “that's everything” card. The argument is the cat's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This home is yours and %@’s now."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个家，交给你和%@了。"
          }
        }
      }
    },
    "tour.allDone.card.line.long" : {
      "comment" : "The “that's everything” card, when the cat's name is too long to repeat.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This home is yours and your cat’s now."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个家，交给你和猫咪了。"
          }
        }
      }
    },
    "tour.allDone.card.title" : {
      "comment" : "The card shown once, after every chapter was read and none skipped.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That’s everything"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都讲完啦"
          }
        }
      }
    },
    "tour.back" : {
      "comment" : "Tour page mode button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一步"
          }
        }
      }
    },
    "tour.backup.1" : {
      "comment" : "Chapter 15, the only step. The window is on the gear (Settings). Backup & restore is a group title in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings, Backup & restore exports a copy you can take to a new device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置里的“备份与恢复”能导出一份，换设备也带得走。"
          }
        }
      }
    },
    "tour.backup.card.line" : {
      "comment" : "Chapter 15 card, one sentence. Speaks only of peace of mind, not of keeping anything safe.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This home is filling up. A backup gives you peace of mind."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个家越来越满了，留一份备份更安心。"
          }
        }
      }
    },
    "tour.backup.card.title" : {
      "comment" : "Chapter 15 card title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up this home"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给这个家留个备份"
          }
        }
      }
    },
    "tour.bringPhoto.1" : {
      "comment" : "Chapter 2, step 1. The window is on Add photos. Owner-approved privacy line, one wording for every device and backup setting.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos come home through here. Only you can see them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片从这里带回家，只有你自己看得到。"
          }
        }
      }
    },
    "tour.bringPhoto.2" : {
      "comment" : "Chapter 2, step 2. The window is on Add photos. The device, not Bella, guesses the furniture.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone guesses the furniture in your photo. Fix the guess, or choose it all yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 会猜照片里是什么家具，猜错了你可以改，也能自己选。"
          }
        }
      }
    },
    "tour.bringPhoto.2.pad" : {
      "comment" : "Chapter 2, step 2, on iPad. The window is on Add photos. The device, not Bella, guesses the furniture.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPad guesses the furniture in your photo. Fix the guess, or choose it all yourself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPad 会猜照片里是什么家具，猜错了你可以改，也能自己选。"
          }
        }
      }
    },
    "tour.bringPhoto.3" : {
      "comment" : "Chapter 2, step 3. The window is on Add photos; tapping it hands over to the photo picker. The argument is the cat's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap here and pick a photo that has %@ and some furniture in it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点这里，挑一张有%@也有家具的照片吧。"
          }
        }
      }
    },
    "tour.bringPhoto.3.long" : {
      "comment" : "Chapter 2, step 3, when the cat's name is too long to repeat.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap here and pick a photo that has your cat and some furniture in it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点这里，挑一张有猫咪也有家具的照片吧。"
          }
        }
      }
    },
    "tour.bringPhoto.card.line" : {
      "comment" : "Chapter 2 card, one sentence.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start from a photo and add a piece to this room."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从一张照片开始，给这间房间添一件家具。"
          }
        }
      }
    },
    "tour.bringPhoto.card.title" : {
      "comment" : "Chapter 2 card title; only shown when replayed from Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring a photo home"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带一张照片回家"
          }
        }
      }
    },
    "tour.company.1" : {
      "comment" : "Chapter 12, step 1. The window is on the Play button (互动). “Keep me company” (陪我一会儿) is the row in the Play panel, sentence case as it shows there.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Play, then Keep me company."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先点“互动”，再点里面的“陪我一会儿”。"
          }
        }
      }
    },
    "tour.company.2" : {
      "comment" : "Chapter 12, step 2. The window is on the “Keep me company” row in the Play panel. “it” is the row.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This row. Tap it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就是这一行，点进去。"
          }
        }
      }
    },
    "tour.company.3" : {
      "comment" : "Chapter 12, step 3. The window is on “Start company” (开始陪伴) on the company page. The argument is the cat's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Start company and %@ turns into a pixel cat on your Lock Screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点“开始陪伴”，%@会变成像素猫，待在锁屏上。"
          }
        }
      }
    },
    "tour.company.3.long" : {
      "comment" : "Chapter 12, step 3, when the cat's name is too long to repeat or empty.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Start company and your cat turns into a pixel cat on your Lock Screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点“开始陪伴”，猫咪会变成像素猫，待在锁屏上。"
          }
        }
      }
    },
    "tour.company.3.off" : {
      "comment" : "Chapter 12, on the company page, when Live Activities are switched off for the app in Settings. The page says how to switch them on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activities are off right now. This page explains how to turn them on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时活动现在关着。这一页下面写了怎么打开。"
          }
        }
      }
    },
    "tour.company.4" : {
      "comment" : "Chapter 12, after company started, on an iPhone with the Dynamic Island. No window. The argument is the cat's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now lock the screen and take a look. You’ll find %@ in the Dynamic Island too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在锁上屏幕看看。灵动岛上也有%@。"
          }
        }
      }
    },
