    "tour.company.controls.actionButton" : {
      "comment" : "Chapter 12, page 2, only on an iPhone with the Action button, under the heading Action button. Each sentence is a numbered step.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and tap Action Button. Swipe to Controls and tap the button below it (on iOS 18, Choose a Control). Choose Keep Me Company."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“设置”，点“操作按钮”。轻扫到“控制”，点下方的按钮（iOS 18 上是“选取控制”）。选“陪我一会儿”。"
          }
        }
      }
    },
    "tour.company.controls.actionButton.title" : {
      "comment" : "Chapter 12, page 2: heading of the Action button steps.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Action button"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作按钮"
          }
        }
      }
    },
    "tour.company.controls.group" : {
      "comment" : "Chapter 12, page 2: heading of the Control Center steps, shown only when the Action button's group follows.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Control Center"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制中心"
          }
        }
      }
    },
    "tour.company.controls.how" : {
      "comment" : "Chapter 12, page 2, how to add the controls. Each sentence is shown as a numbered step. The three names are the controls' names in the controls gallery: Keep Me Company, Take Photo, Add from Photos.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Control Center: on an iPhone with Face ID, swipe down from the top-right corner; on an iPhone with a Home button, swipe up from the bottom. Tap the Add button (+) at the top left, then Add a Control at the bottom of the screen. Find Meowverse in the controls gallery: Keep Me Company, Take Photo and Add from Photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开控制中心：配备面容 ID 的 iPhone 从屏幕右上角向下轻扫，配备主屏幕按钮的 iPhone 从屏幕底部向上轻扫。点左上方的“添加”按钮（＋），再点屏幕底部的“添加控制”。在控制资源库里找到喵空间，有三个：陪我一会儿、拍照添加、从相册添加。"
          }
        }
      }
    },
    "tour.company.controls.line" : {
      "comment" : "Chapter 12, page 2, Bella's line. “它” is the cat.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can call your cat over without opening the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用打开 App，也能把它叫出来。"
          }
        }
      }
    },
    "tour.company.controls.needsLive" : {
      "comment" : "Chapter 12, page 2, only while Live Activities are off for the app.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Me Company needs Live Activities. While they’re off, turn them on in Settings › Apps › Meowverse › Live Activities."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“陪我一会儿”要用到实时活动。实时活动关着时，先到“设置”›“App”›“喵空间”里打开“实时活动”。"
          }
        }
      }
    },
    "tour.company.controls.title" : {
      "comment" : "Chapter 12, page 2 title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Control Center"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放进控制中心"
          }
        }
      }
    },
    "tour.company.home.how" : {
      "comment" : "Chapter 12, page 1, how to add the Pixel Cat widget to the Home Screen. Each sentence is shown as a numbered step. Wording follows Apple's iPhone User Guide.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Home Screen, touch and hold the background until the apps jiggle. Tap Edit at the top of the screen, then Add Widget. Search for Meowverse, tap Pixel Cat, choose a size, tap Add Widget, then tap Done."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主屏幕上按住背景，直到 App 开始抖动。点屏幕顶部的“编辑”，再点“添加小组件”。搜索“喵空间”，点“像素猫”，选好大小，点“添加小组件”，最后点“完成”。"
          }
        }
      }
    },
    "tour.company.home.line" : {
      "comment" : "Chapter 12, page 1, Bella's line. “Pixel Cat” is the widget's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to see your cat every time you unlock? Put Pixel Cat on your Home Screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想每次解锁都看到它？把“像素猫”放到主屏幕。"
          }
        }
      }
    },
    "tour.company.home.lock" : {
      "comment" : "Chapter 12, page 1, how to add the widget to the Lock Screen, under the heading Lock Screen. Each sentence is a numbered step. Add Widgets is plural on the Lock Screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Lock Screen, then tap Customize (on iOS 18, then tap Lock Screen). Tap Add Widgets and choose Pixel Cat. Then tap Done."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住锁屏，点“自定义”（iOS 18 上接着点“锁定屏幕”）。点“添加小组件”，选“像素猫”。最后点“完成”。"
          }
        }
      }
    },
    "tour.company.home.title" : {
      "comment" : "Chapter 12, page 1 title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your Home Screen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放到主屏幕"
          }
        }
