          }
        }
      }
    },
    "确认后，这份备份会替换你已有的所有房间和猫咪，以及 %lld 张照片和 %lld 件家具。此操作无法撤销。如需保留，请先取消并导出备份。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup will replace all your rooms and cats, along with %#@n1@ and %#@n2@. You can’t undo this. To keep your current content, cancel and export a backup first."
          },
          "substitutions" : {
            "n1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
