          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Companion session"
          }
        }
      }
    },
    "Couldn’t start this Live Activity. Try again, or check Live Activities in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没能开始陪伴。请重试，或到系统设置中检查「实时活动」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t start this Live Activity. Try again, or check Live Activities in Settings."
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
