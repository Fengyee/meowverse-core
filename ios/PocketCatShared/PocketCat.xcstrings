{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@, pixel cat with changing expressions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，像素猫，表情会自动变化"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, pixel cat with changing expressions"
          }
        }
      }
    },
    "Add from Photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册添加"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add from Photos"
          }
        }
      }
    },
    "Add photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加照片"
          }
