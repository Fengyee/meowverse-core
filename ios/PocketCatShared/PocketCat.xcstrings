            "state": "translated",
            "value": "Add photos"
          }
        }
      }
    },
    "Change expression": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换个表情"
          }
        },
        "en": {
