    "Thinking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在思考"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        }
      }
    },
    "To invite your pixel cat, allow Live Activities in the app’s settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 App 的系统设置中允许「实时活动」，再邀请像素猫。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To invite your pixel cat, allow Live Activities in the app’s settings."
          }
        }
      }
    },
    "Watching": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在观察"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watching"
          }
        }
      }
    },
    "Your pixel cat appears on the Lock Screen and, on supported iPhones, in the Dynamic Island. It changes to a random expression every five minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只像素猫会出现在锁定屏幕上。在支持灵动岛的 iPhone 上，也可以在岛上看到它。陪伴期间，猫咪每 5 分钟会随机换一个表情。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pixel cat appears on the Lock Screen and, on supported iPhones, in the Dynamic Island. It changes to a random expression every five minutes."
          }
        }
      }
    },
    "Your pixel cat comes to the Lock Screen without opening the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素猫会来到锁定屏幕，不用打开 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pixel cat comes to the Lock Screen without opening the app."
          }
        }
      }
    },
    "Your pixel cat on the Lock Screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏上的像素猫。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pixel cat on the Lock Screen."
          }
        }
      }
    },
    "Your pixel cat, and a button that brings it to keep you company.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的像素猫，点一下按钮，它就来陪你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pixel cat, and a button that brings it to keep you company."
          }
        }
      }
    },
    "Zoomies": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在疯"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomies"
          }
        }
      }
