    "Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "Opens Meowverse to choose photos for your cat’s home.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开喵空间，从相册选照片放进猫咪的家。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Meowverse to choose photos for your cat’s home."
          }
        }
      }
    },
    "Opens Meowverse to take a photo for your cat’s home.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开喵空间，拍一张照片放进猫咪的家。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Meowverse to take a photo for your cat’s home."
          }
        }
      }
    },
